# Copia questo file in .env e riempi solo cio' che ti serve.
#
# NOTA: per l'uso normale non serve nulla di tutto questo. Gli account si
# collegano dall'app con "Collega account". Questo file esiste per chi
# preferisce configurare a mano o per lo sviluppo.

# --- Modalita' prodotto -----------------------------------------------
# customer = versione distribuita (default)
# personal = mostra anche i moduli personali
APP_MODE=customer

# --- YouTube: configurazione manuale (facoltativa) --------------------
# Formato: YT_CHANNELS=nome1:PREFIX1,nome2:PREFIX2
YT_CHANNELS=
# NOME_YOUTUBE_CLIENT_ID=
# NOME_YOUTUBE_CLIENT_SECRET=
# NOME_YOUTUBE_REFRESH_TOKEN=
# Solo se il token e' stato creato con uno scope diverso da youtube.readonly:
# NOME_YOUTUBE_SCOPE=https://www.googleapis.com/auth/youtube.readonly

# --- Instagram: configurazione manuale (facoltativa) ------------------
# Formato: IG_ACCOUNTS=nome1:PREFIX1,nome2:PREFIX2
IG_ACCOUNTS=
# NOME_IG_API=instagram        # "instagram" oppure "facebook"
# NOME_IG_ACCESS_TOKEN=
# NOME_IG_USER_ID=

# --- TikTok: configurazione manuale (facoltativa) ---------------------
# Formato: TT_ACCOUNTS=nome1:PREFIX1,nome2:PREFIX2
TT_ACCOUNTS=
# NOME_TIKTOK_CLIENT_KEY=
# NOME_TIKTOK_CLIENT_SECRET=
# NOME_TIKTOK_REFRESH_TOKEN=

# --- X / Twitter ------------------------------------------------------
# Il piano gratuito non espone metriche di lettura: la sezione resta
# informativa anche con le credenziali presenti.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Analisi AI (facoltativa, a consumo) ------------------------------
# Serve solo al pulsante "Analizza". Senza chiave il resto funziona lo stesso.
ANTHROPIC_API_KEY=
INSIGHTS_MODEL=claude-haiku-4-5-20251001

# --- Pagamenti (solo per chi distribuisce l'app) ----------------------
# STRIPE_SECRET_KEY=
# APP_PUBLIC_URL=http://127.0.0.1:8787

# --- Moduli personali (APP_MODE=personal) -----------------------------
# CERTSPRINT_REPO_PATH=
# CERTSPRINT_PUBLIC_URL=
